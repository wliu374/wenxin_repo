---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { profile, visibleLinks } from "../../content/profile";

const links = visibleLinks(profile.links);

function label(value: string): string {
  return value.charAt(0).toUpperCase() + value.slice(1);
}

function formatList(items: readonly string[]): string {
  if (items.length === 0) return "";
  if (items.length === 1) return items[0];
  return `${items.slice(0, -1).join(", ")}, and ${items[items.length - 1]}`;
}
---

<Base title={`About · ${profile.name}`} description={profile.summary}>
  <div class="shell page">
    <PageHero eyebrow={profile.department} title={profile.name} lede={profile.summary} />
    <div class="stack">
      {
        profile.education.length > 0 && (
          <section class="block" aria-labelledby="education-heading">
            <h2 id="education-heading">Education</h2>
            <div class="info-grid">
              {profile.education.map((item) => (
                <article class="info-card">
                  <p class="eyebrow">{item.current ? "Current" : "Prior"}</p>
                  <h3>{item.degree}</h3>
                  <p>{item.institution}</p>
                  <p>{item.focus}</p>
                </article>
              ))}
            </div>
          </section>
        )
      }
      {
        profile.researchInterests.length > 0 && (
          <section class="block" aria-labelledby="interests-heading">
            <h2 id="interests-heading">Research interests</h2>
            <ul class="tags">
              {profile.researchInterests.map((interest) => (
                <li class="chip">{label(interest)}</li>
              ))}
            </ul>
          </section>
        )
      }
      {
        profile.personalInterests.length > 0 && (
          <section class="block" aria-labelledby="also-heading">
            <h2 id="also-heading">Also interested in</h2>
            <p class="prose">{formatList(profile.personalInterests)}.</p>
          </section>
        )
      }
      {
        links.length > 0 && (
          <section class="block" aria-labelledby="contact-heading">
            <h2 id="contact-heading">Contact</h2>
            <div class="hero__actions">
              {links.map((link, index) => (
                <a class:list={["pill", index === 0 ? "pill--primary" : "pill--ghost"]} href={link.href}>
                  {link.label}
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</Base>
