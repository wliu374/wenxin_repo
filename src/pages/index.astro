---
import Base from "../layouts/Base.astro";
import { profile, visibleLinks } from "../content/profile";
import { researchAreas } from "../content/research";
import { publications } from "../content/publications";
import { withBase } from "../lib/withBase";

const scholar = visibleLinks(profile.links).find((link) => link.label === "Google Scholar");
const primaryResearch = researchAreas[0];

const cards: { href: string; eyebrow: string; title: string; text: string }[] = [];
if (primaryResearch) {
  cards.push({
    href: "/research/",
    eyebrow: "Research",
    title: primaryResearch.title,
    text: primaryResearch.summary,
  });
}
cards.push({
  href: "/publications/",
  eyebrow: "Publications",
  title: publications.length === 1 ? "1 paper" : `${publications.length} papers`,
  text: publications[0]?.title ?? "Selected papers will be listed here.",
});
cards.push({
  href: "/about/",
  eyebrow: "About",
  title: profile.role,
  text: `${profile.department}, ${profile.affiliation}`,
});
---

<Base title={profile.name} description={profile.summary}>
  <section class="hero">
    <div class="shell hero__layout">
      <div>
        <p class="eyebrow">{profile.role} · {profile.affiliation}</p>
        <h1>
          <span>{profile.headlineLead}</span>
          <span class="hero__accent">{profile.headlineAccent}</span>
        </h1>
        <p class="intro">{profile.summary}</p>
        <div class="hero__actions">
          <a class="pill pill--primary" href={withBase("/research/")}>Research</a>
          <a class="pill pill--ghost" href={withBase("/publications/")}>Publications</a>
          {scholar && <a class="pill pill--ghost" href={scholar.href}>{scholar.label}</a>}
        </div>
      </div>
      {
        profile.headshot && (
          <figure class="hero__photo">
            <img
              src={withBase(profile.headshot)}
              alt={profile.headshotAlt || profile.name}
              width="288"
              height="360"
            />
          </figure>
        )
      }
    </div>
  </section>
  <section class="band" aria-label="Sections">
    <div class="shell card-grid">
      {
        cards.map((card) => (
          <a class="preview-card" href={withBase(card.href)}>
            <p class="eyebrow">{card.eyebrow}</p>
            <h2>{card.title}</h2>
            <p>{card.text}</p>
            <span class="preview-card__go">Open</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
