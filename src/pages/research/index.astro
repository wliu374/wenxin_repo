---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { profile } from "../../content/profile";
import { researchAreas } from "../../content/research";

const area = researchAreas[0];
const title = area ? `${area.title} · ${profile.name}` : `Research · ${profile.name}`;
const description = area?.summary ?? "Research will be added here.";
---

<Base title={title} description={description}>
  <div class="shell page">
    {
      area ? (
        <>
          <PageHero
            eyebrow="Research"
            title={area.title}
            lede={area.expansion}
            accent={Boolean(area.expansion)}
          />
          <div class="stack">
            <section class="block" aria-labelledby="overview-heading">
              <h2 id="overview-heading">Overview</h2>
              <div class="overview-card">
                <p class="prose">{area.summary}</p>
                <p class="prose">{area.description}</p>
              </div>
            </section>
            {area.pipeline && area.pipeline.length > 0 && (
              <section class="block" aria-labelledby="pipeline-heading">
                <h2 id="pipeline-heading">Pipeline</h2>
                <ol class="steps">
                  {area.pipeline.map((step, index) => (
                    <li class="step">
                      <span class="step__index">{String(index + 1).padStart(2, "0")}</span>
                      <h3>{step.title}</h3>
                      <p>{step.detail}</p>
                    </li>
                  ))}
                </ol>
              </section>
            )}
            {area.skills.length > 0 && (
              <section class="block" aria-labelledby="skills-heading">
                <h2 id="skills-heading">Skills</h2>
                <ul class="tags">
                  {area.skills.map((skill) => (
                    <li class="chip">{skill}</li>
                  ))}
                </ul>
              </section>
            )}
            {area.caseStudy && (
              <section class="block" aria-labelledby="case-heading">
                <h2 id="case-heading">Case study</h2>
                <article class="case-card">
                  <p class="eyebrow">Field test</p>
                  <h3>{area.caseStudy.title}</h3>
                  <p>{area.caseStudy.detail}</p>
                </article>
              </section>
            )}
          </div>
        </>
      ) : (
        <p class="empty">Research will be added here.</p>
      )
    }
  </div>
</Base>
