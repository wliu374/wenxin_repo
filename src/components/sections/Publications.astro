---
import SectionHeading from "../SectionHeading.astro";
import type { PublicationStatus } from "../../content/types";
import {
  highlightedAuthor,
  publications,
  scholarProfileUrl,
} from "../../content/publications";

const statusLabel: Record<PublicationStatus, string> = {
  published: "Published",
  "under review": "Under review",
  "in prep": "In prep",
};
---

<section class="section" id="publications" aria-labelledby="publications-heading">
  <div class="shell column">
    <SectionHeading index="02" title="Publications" id="publications-heading" />
    {
      publications.length === 0 ? (
        <p class="empty">Publications will be added here.</p>
      ) : (
        <ol class="pub-list">
          {publications.map((publication) => (
            <li class="pub">
              <p class="pub__year">{publication.year}</p>
              <div>
                <h3>{publication.title}</h3>
                <p class="pub__authors">
                  {publication.authors.map((author, index) => (
                    <span>
                      {index > 0 && ", "}
                      {author === highlightedAuthor ? (
                        <strong>{author}</strong>
                      ) : (
                        author
                      )}
                    </span>
                  ))}
                </p>
                <p class="pub__meta">
                  {publication.venue}
                  <span aria-hidden="true"> · </span>
                  {statusLabel[publication.status]}
                </p>
                {(publication.links?.pdf ||
                  publication.links?.doi ||
                  publication.links?.code) && (
                  <p class="pub__links">
                    {publication.links?.pdf && (
                      <a href={publication.links.pdf}>PDF</a>
                    )}
                    {publication.links?.doi && (
                      <a href={publication.links.doi}>DOI</a>
                    )}
                    {publication.links?.code && (
                      <a href={publication.links.code}>Code</a>
                    )}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
      )
    }
    <p class="scholar-more">
      <a href={scholarProfileUrl}>Full list on Google Scholar</a>
    </p>
  </div>
</section>
