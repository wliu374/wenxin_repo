---
import { profile, visibleLinks } from "../../content/profile";
import { withBase } from "../../lib/withBase";

const links = visibleLinks(profile.links);
const priorDegrees = profile.education.filter((item) => !item.current);

function formatList(items: readonly string[]): string {
  if (items.length === 0) return "";
  const sentence =
    items.length === 1
      ? items[0]
      : `${items.slice(0, -1).join(", ")}, and ${items[items.length - 1]}`;
  return sentence.charAt(0).toUpperCase() + sentence.slice(1);
}
---

<section class="hero" id="about" aria-labelledby="about-title">
  <div class="shell column">
    {
      profile.headshot && (
        <img
          class="portrait"
          src={withBase(profile.headshot)}
          alt={profile.headshotAlt || profile.name}
          width="120"
          height="120"
        />
      )
    }
    <p class="kicker">{profile.department}</p>
    <h1 id="about-title">{profile.name}</h1>
    <p class="role">{profile.role} · {profile.affiliation}</p>
    {
      priorDegrees.map((item) => (
        <p class="degree">
          {item.degree} at {item.institution} in {item.focus}.
        </p>
      ))
    }
    {
      profile.researchInterests.length > 0 && (
        <div class="interest-block">
          <p class="meta-label">Research interests</p>
          <p class="interest-line">{formatList(profile.researchInterests)}.</p>
        </div>
      )
    }
    {
      profile.personalInterests.length > 0 && (
        <div class="interest-block">
          <p class="meta-label">Also interested in</p>
          <p class="interest-line">{formatList(profile.personalInterests)}.</p>
        </div>
      )
    }
    {
      links.length > 0 && (
        <ul class="contact-links">
          {links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
