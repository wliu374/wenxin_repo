---
import { profile, visibleLinks } from "../content/profile";

const links = visibleLinks(profile.links);

function label(value: string): string {
  return value.charAt(0).toUpperCase() + value.slice(1);
}

function formatList(items: readonly string[]): string {
  if (items.length <= 1) return items[0] ?? "";
  return `${items.slice(0, -1).join(", ")}, and ${items[items.length - 1]}`;
}
---

<div class="stack">
  <section aria-labelledby="bio-heading">
    <h2 id="bio-heading" class="section-title">Biography</h2>
    <div class="prose">
      <p>{profile.summary}</p>
    </div>
  </section>

  {
    profile.education.length > 0 && (
      <section aria-labelledby="education-heading">
        <h2 id="education-heading" class="section-title">Education</h2>
        <div class="degrees">
          {profile.education.map((item) => (
            <article class="degree">
              <p class="eyebrow">{item.current ? "Current" : "Prior"}</p>
              <h3>{item.degree}</h3>
              <p>{item.institution}</p>
              <p>{item.focus}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    profile.researchInterests.length > 0 && (
      <section aria-labelledby="interests-heading">
        <h2 id="interests-heading" class="section-title">Research interests</h2>
        <ul class="interest-list">
          {profile.researchInterests.map((interest) => (
            <li>{label(interest)}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    profile.personalInterests.length > 0 && (
      <section aria-labelledby="also-heading">
        <h2 id="also-heading" class="section-title">Also interested in</h2>
        <p class="quiet">{formatList(profile.personalInterests)}.</p>
      </section>
    )
  }

  {
    links.length > 0 && (
      <section aria-labelledby="contact-heading">
        <h2 id="contact-heading" class="section-title">Contact</h2>
        <p class="contact-line">
          {links.map((link, index) => (
            <>
              {index > 0 && " · "}
              <a href={link.href}>{link.label}</a>
            </>
          ))}
        </p>
      </section>
    )
  }
</div>
