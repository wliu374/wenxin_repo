---
import { profile, visibleLinks } from "../content/profile";
import { isCurrentPath, pages } from "../lib/pages";
import { withBase } from "../lib/withBase";

const links = visibleLinks(profile.links);
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <p class="site-footer__name">{profile.name}</p>
      <p class="site-footer__role">{profile.role}, {profile.department}</p>
      <p class="site-footer__affil">{profile.affiliation}</p>
    </div>
    <ul class="footer-links">
      {
        pages.map((page) => (
          <li>
            <a
              href={withBase(page.href)}
              aria-current={isCurrentPath(Astro.url.pathname, page.href) ? "page" : undefined}
            >
              {page.label}
            </a>
          </li>
        ))
      }
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
