---
interface Props {
  index: string;
  title: string;
  id: string;
}

const { index, title, id } = Astro.props;
---

<h2 class="section-heading" id={id}>
  <span class="section-heading__index">{index}</span>
  <span class="section-heading__sep" aria-hidden="true">/</span>
  <span class="section-heading__title">{title}</span>
</h2>
